{
  "name": "agent-otel",
  "version": "0.0.3",
  "description": "The OTel router for agent telemetry. Fanout to any eval, training, observability, or archival sink.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sinks": "./src/sinks/index.ts",
    "./sinks/otlp": "./src/sinks/otlp.ts",
    "./sinks/jsonl": "./src/sinks/jsonl.ts",
    "./sinks/memory": "./src/sinks/memory.ts",
    "./sinks/phoenix": "./src/sinks/phoenix.ts",
    "./sinks/braintrust": "./src/sinks/braintrust.ts",
    "./sinks/slack": "./src/sinks/slack.ts",
    "./replay": "./src/replay.ts",
    "./privacy": "./src/privacy.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opentelemetry",
    "otel",
    "agent",
    "llm",
    "tracing",
    "router",
    "openinference",
    "phoenix",
    "braintrust",
    "eval",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mirkokiefer/daslab",
    "directory": "oss/agent-otel"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "pii-proxy": "^0.1.0"
  }
}
